Size=16;" value="" vertex="1"><mxGeometry x="0" y="30" width="280" height="26" as="geometry"/></mxCell><mxCell id="c39" parent="c38" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;fontSize=15;align=left;spacingLeft=6;fontFamily=Courier New;" value="finished_at" vertex="1"><mxGeometry x="0" y="0" width="280" height="26" as="geometry"/></mxCell><mxCell id="c40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=none;strokeColor=#006EAF;dashed=1;dashPattern=8 8;strokeWidth=3;" value="" vertex="1"><mxGeometry x="390" y="110" width="700" height="880" as="geometry"/></mxCell><mxCell id="c41" parent="1" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/png,;" value="" vertex="1"><mxGeometry x="950" y="70" width="80" height="79.7" as="geometry"/></mxCell><mxCell id="c42" parent="1" style="sketch=0;aspect=fixed;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=#006EAF;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#1ba1e2;shape=mxgraph.azure.script_file;fontColor=default;fontSize=18;" value="Pre-processing" vertex="1"><mxGeometry x="425" y="506.4" width="82" height="87.2" as="geometry"/></mxCell><mxCell id="c43" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=2;" value="&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Keep one row per distinct skill (same rule as Figure 2)&lt;/li&gt;&lt;li&gt;Parse commit times as UTC&lt;/li&gt;&lt;li&gt;Flag AI co-authored commits and bot authors&lt;/li&gt;&lt;li&gt;Sample edited skills (&lt;font face=&quot;Courier New&quot;&gt;commit_count&lt;/font&gt; &amp;gt; 1), stratified by &lt;font face=&quot;Courier New&quot;&gt;location_class&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1"><mxGeometry x="398" y="630.0" width="245" height="330" as="geometry"/></mxCell><mxCell id="c44" parent="1" style="sketch=0;aspect=fixed;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=#006EAF;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#1ba1e2;shape=mxgraph.azure.script_file;fontColor=default;fontSize=18;" value="" vertex="1"><mxGeometry x="680" y="206.4" width="82" height="87.2" as="geometry"/></mxCell><mxCell id="c45" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=2;" value="&lt;b&gt;Cross-copy churn&lt;/b&gt;&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Order each family&#x27;s members by &lt;font face=&quot;Courier New&quot;&gt;first_commit_at&lt;/font&gt;, else &lt;font face=&quot;Courier New&quot;&gt;repos.created_at&lt;/font&gt;&lt;/li&gt;&lt;li&gt;Parent = most similar earlier member (token similarity)&lt;/li&gt;&lt;li&gt;Diff each member with its parent: tokens added and removed&lt;/li&gt;&lt;li&gt;Links below 0.5 similarity are dropped; near-copy &amp;ge; 0.9, variant 0.5&amp;ndash;0.9&lt;/li&gt;&lt;/ul&gt;" vertex="1"><mxGeometry x="775" y="175" width="305" height="150" as="geometry"/></mxCell><mxCell id="c46" parent="1" style="sketch=0;aspect=fixed;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=#006EAF;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#1ba1e2;shape=mxgraph.azure.script_file;fontColor=default;fontSize=18;" value="" vertex="1"><mxGeometry x="680" y="506.4" width="82" height="87.2" as="geometry"/></mxCell><mxCell id="c47" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=2;" value="&lt;b&gt;Activity churn&lt;/b&gt;&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Edits = &lt;font face=&quot;Courier New&quot;&gt;commit_count&lt;/font&gt; &amp;minus; 1, and edits per month&lt;/li&gt;&lt;li&gt;Active span, and dormancy up to the snapshot (&lt;font face=&quot;Courier New&quot;&gt;finished_at&lt;/font&gt;)&lt;/li&gt;&lt;li&gt;Author change, AI co-authorship, and dormancy in an active repo (&lt;font face=&quot;Courier New&quot;&gt;pushed_at&lt;/font&gt;)&lt;/li&gt;&lt;/ul&gt;" vertex="1"><mxGeometry x="775" y="475" width="305" height="150" as="geometry"/></mxCell><mxCell id="c48" parent="1" style="sketch=0;aspect=fixed;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=#006EAF;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;fillColor=#1ba1e2;shape=mxgraph.azure.script_file;fontColor=default;fontSize=18;" value="" vertex="1"><mxGeometry x="680" y="806.4" width="82" height="87.2" as="geometry"/></mxCell><mxCell id="c49" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=17;spacing=2;" value="&lt;b&gt;Token churn&lt;/b&gt;&lt;ul style=&quot;margin:0;padding-left:16px&quot;&gt;&lt;li&gt;Sampled skills only: follow the file&#x27;s history through renames (&lt;span style=&#x27;white-space:nowrap&#x27;&gt;&lt;font face=&quot;Courier New&quot;&gt;git log --follow&lt;/font&gt;&lt;/span&gt;)&lt;/li&gt;&lt;li&gt;Tokenize every version with the Anthropic tokenizer&lt;/li&gt;&lt;li&gt;Diff consecutive versions: tokens added and removed, relative to the earlier version&#x27;s size&lt;/li&gt;&lt;/ul&gt;" vertex="1"><mxGeometry x="775" y="775" width="305" height="150" as="geometry"/></mxCell><mxCell id="c50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#006EAF;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=17;" value="&lt;b&gt;Clone coverage&lt;/b&gt;&lt;br&gt;near-clone families (&lt;font face=&quot;Courier New&quot;&gt;family_id&lt;/font&gt;)" vertex="1"><mxGeometry x="601" y="-10" width="240" height="80" as="geometry"/></mxCell><mxCell id="c51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#006EAF;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=17;" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;git clone 